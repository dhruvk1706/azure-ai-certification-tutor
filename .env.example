# Copy to .env. Never commit .env.

# --- PostgreSQL ---
# Choose your own password, and use the same one in DATABASE_URL below.
POSTGRES_USER=tutor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tutor
POSTGRES_PORT=5432
# Used when the backend runs on the host. Docker Compose overrides the host with `db`.
DATABASE_URL=postgresql+psycopg://tutor:change-me@localhost:5432/tutor

# --- LLM: any OpenAI-compatible endpoint ---
# No provider is assumed, so all three are required. Values per provider are in README.md.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional. How long to wait for a reply, in seconds. Defaults to 120.
LLM_TIMEOUT_SECONDS=

# Optional. Tutor, lesson, plan narration and lab assistant requests allowed per hour,
# per learner and in total. Defaults 60 and 300. Set either to 0 to turn them off.
LLM_LEARNER_HOURLY_LIMIT=
LLM_HOURLY_LIMIT=

# Optional. Question generation requests allowed per hour, per learner and in total.
# Defaults 10 and 60. Set either to 0 to turn generation off.
QUESTION_GENERATION_LEARNER_HOURLY_LIMIT=
QUESTION_GENERATION_HOURLY_LIMIT=

# --- Embeddings (reserved: nothing reads these yet) ---
# Leave the URL and key blank to reuse LLM_BASE_URL and LLM_API_KEY.
# Set them if your chat provider has no embeddings API.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Ollama container (only used with --profile ollama) ---
OLLAMA_PORT=11434

# --- Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Frontend (VITE_* values are exposed to the browser: no secrets) ---
VITE_API_URL=http://localhost:8000
